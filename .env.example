# =====================================================================
# FLOW CHAMADOS - VARIÁVEIS DE AMBIENTE (.env)
# =====================================================================

# 1. Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flow_db
DB_USER=postgres
DB_PASSWORD=postgres

# 2. Credenciais do Trello (API Oficial)
# Obtenha em: https://trello.com/power-ups/admin
TRELLO_ENABLED=true
TRELLO_API_KEY=sua_api_key_do_trello
TRELLO_TOKEN=seu_token_de_acesso_do_trello
TRELLO_BOARD_ID=id_do_quadro_do_trello

# URL pública que o Trello acessará para enviar os Webhooks (ex: via ngrok em dev)
TRELLO_WEBHOOK_URL=https://seu-dominio.ngrok-free.app/api/webhooks/trello

# IDs das 4 Listas correspondentes no seu Board do Trello:
# (Para descobrir os IDs das listas, acesse: https://api.trello.com/1/boards/{BOARD_ID}/lists?key={API_KEY}&token={TOKEN})
TRELLO_LIST_CRIADO=id_da_lista_criado
TRELLO_LIST_EM_ANDAMENTO=id_da_lista_em_andamento
TRELLO_LIST_AGUARDANDO_ACAO=id_da_lista_aguardando_acao
TRELLO_LIST_FINALIZADO=id_da_lista_finalizado

# 3. Chave Administrativa da Aplicação
ADMIN_API_KEY=flow-admin-secret-2026
